# Databricks profile used for the reflection LM (Foundation Model API) when running locally
DATABRICKS_CONFIG_PROFILE=fe-vm-lakebase-praneeth
# databricks:<endpoint> or anthropic:<model>
REFLECTION_LM=databricks:databricks-claude-sonnet-4-5
# ANTHROPIC_API_KEY=...   # only for the anthropic: route
WS_CATALOG=serverless_lakebase_praneeth_catalog
WS_SCHEMA=weightspace
