{
  "run_name": "dspy-weightspace-e2e",
  "tasks": [
    {
      "task_key": "run",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/__USER__/dspy-weightspace/databricks",
        "base_parameters": {
          "reflection_endpoint": "__REFLECTION_ENDPOINT__",
          "catalog": "serverless_lakebase_praneeth_catalog",
          "schema": "weightspace",
          "n_dev": "48",
          "n_holdout": "48",
          "max_new_tokens": "4096",
          "passes_per_round": "8",
          "max_metric_calls": "200"
        }
      },
      "new_cluster": {
        "spark_version": "17.3.x-gpu-ml-scala2.13",
        "node_type_id": "g5.2xlarge",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER",
        "single_user_name": "__USER__",
        "spark_conf": {
          "spark.master": "local[*, 4]",
          "spark.databricks.cluster.profile": "singleNode"
        },
        "custom_tags": {"ResourceClass": "SingleNode", "project": "dspy-weightspace"},
        "aws_attributes": {"availability": "SPOT_WITH_FALLBACK", "first_on_demand": 1}
      },
      "timeout_seconds": 14400
    }
  ]
}
